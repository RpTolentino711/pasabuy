@{ Layout = "_Layout"; }
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h5 class="fw-bold mb-0">Marketplace Categories</h5>
        <button class="btn btn-sm btn-primary rounded-pill px-4"><i class="fa-solid fa-plus me-1"></i> Add Category</button>
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr><th>Icon</th><th>Category Name</th><th>Description</th><th>Sort Order</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                <tr><td><i class="fa-solid fa-laptop text-primary fs-5"></i></td><td class="fw-bold">Electronics</td><td>Laptops, monitors, gadgets</td><td>1</td><td><span class="badge bg-success rounded-pill">Active</span></td><td class="text-end"><button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Edit</button></td></tr>
                <tr><td><i class="fa-solid fa-headphones text-info fs-5"></i></td><td class="fw-bold">Gadgets</td><td>Earphones, chargers, cables</td><td>2</td><td><span class="badge bg-success rounded-pill">Active</span></td><td class="text-end"><button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Edit</button></td></tr>
                <tr><td><i class="fa-solid fa-calculator text-warning fs-5"></i></td><td class="fw-bold">School Supplies</td><td>Calculators, pens, drafting tools</td><td>3</td><td><span class="badge bg-success rounded-pill">Active</span></td><td class="text-end"><button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Edit</button></td></tr>
                <tr><td><i class="fa-solid fa-book text-success fs-5"></i></td><td class="fw-bold">Books</td><td>Textbooks, reviewer books, novels</td><td>4</td><td><span class="badge bg-success rounded-pill">Active</span></td><td class="text-end"><button class="btn btn-sm btn-outline-secondary rounded-pill px-3">Edit</button></td></tr>
            </tbody>
        </table>
    </div>
</div>
