@{
    Layout = "_Layout";
}

<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h5 class="fw-bold mb-1">Approved Campus Safe Meetup Locations</h5>
            <p class="text-muted fs-7 mb-0">Only verified public campus locations are allowed for buyer/seller face-to-face meetups.</p>
        </div>
        <button class="btn btn-sm btn-primary rounded-pill px-4"><i class="fa-solid fa-plus me-1"></i> Add Meetup Spot</button>
    </div>

    <div class="row g-4">
        <div class="col-md-6 col-lg-4">
            <div class="p-3 border rounded-4 bg-light">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="p-3 bg-danger text-white rounded-3 fs-5"><i class="fa-solid fa-shield-halved"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Main Gate Entrance</h6>
                        <span class="fs-8 text-muted">Primary Security Booth</span>
                    </div>
                </div>
                <p class="fs-8 text-secondary mb-2">Location: Gate 1 Near Guard Post</p>
                <span class="badge bg-success rounded-pill">Active Public Spot</span>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="p-3 border rounded-4 bg-light">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="p-3 bg-primary text-white rounded-3 fs-5"><i class="fa-solid fa-book-open"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">University Library Lobby</h6>
                        <span class="fs-8 text-muted">Ground Floor Lounge</span>
                    </div>
                </div>
                <p class="fs-8 text-secondary mb-2">Location: Near Info Desk</p>
                <span class="badge bg-success rounded-pill">Active Public Spot</span>
            </div>
        </div>

        <div class="col-md-6 col-lg-4">
            <div class="p-3 border rounded-4 bg-light">
                <div class="d-flex align-items-center gap-3 mb-2">
                    <div class="p-3 bg-warning text-dark rounded-3 fs-5"><i class="fa-solid fa-utensils"></i></div>
                    <div>
                        <h6 class="fw-bold mb-0">Student Center Cafeteria</h6>
                        <span class="fs-8 text-muted">Main Dining Hall</span>
                    </div>
                </div>
                <p class="fs-8 text-secondary mb-2">Location: Central Pavilion</p>
                <span class="badge bg-success rounded-pill">Active Public Spot</span>
            </div>
        </div>
    </div>
</div>
