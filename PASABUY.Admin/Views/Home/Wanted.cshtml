@{ Layout = "_Layout"; }
<div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
    <h5 class="fw-bold mb-4">Student Wanted Requests</h5>
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr><th>Wanted Title</th><th>Requester</th><th>Max Budget</th><th>Category</th><th>Status</th><th class="text-end">Actions</th></tr>
            </thead>
            <tbody>
                <tr>
                    <td class="fw-bold">Arduino Uno R3 starter kit</td>
                    <td>Maria Santos</td>
                    <td class="text-success fw-bold">₱800.00</td>
                    <td><span class="badge bg-secondary-subtle text-secondary rounded-pill">Electronics</span></td>
                    <td><span class="badge bg-success rounded-pill">ACTIVE</span></td>
                    <td class="text-end"><button class="btn btn-sm btn-outline-danger rounded-pill px-3">Remove</button></td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
