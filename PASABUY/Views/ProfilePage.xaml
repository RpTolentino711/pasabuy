<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PASABUY.Views.ProfilePage"
             Title="Profile"
             BackgroundColor="#F4F6F9">

    <Grid RowDefinitions="Auto, *">
        <!-- Top App Bar Header -->
        <Border Grid.Row="0"
                BackgroundColor="#5F27CD"
                StrokeThickness="0"
                Padding="20,16">
            <Grid ColumnDefinitions="*, Auto">
                <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <Label Text="🛍️" FontSize="20" VerticalOptions="Center"/>
                    <Label Text="PasaBuy"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalOptions="Center"/>
                </HorizontalStackLayout>
                
                <Border Grid.Column="1"
                        BackgroundColor="#E3FCEF"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        Padding="10,4">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="✓" TextColor="#00875A" FontAttributes="Bold" FontSize="12"/>
                        <Label Text="Verified Student" TextColor="#00875A" FontAttributes="Bold" FontSize="12"/>
                    </HorizontalStackLayout>
                </Border>
            </Grid>
        </Border>

        <!-- Body Scrollable Content -->
        <ScrollView Grid.Row="1" Padding="16">
            <VerticalStackLayout Spacing="16">
                
                <!-- Profile Header Card -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1"
                        Stroke="#E2E8F0"
                        Padding="20">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        
                        <!-- Avatar Container with Camera Badge -->
                        <Grid WidthRequest="80" HeightRequest="80" HorizontalOptions="Center">
                            <Border StrokeShape="RoundRectangle 40"
                                    StrokeThickness="1"
                                    Stroke="#CBD5E1"
                                    WidthRequest="80"
                                    HeightRequest="80">
                                <Image Source="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&amp;q=80"
                                       Aspect="AspectFill"
                                       WidthRequest="80"
                                       HeightRequest="80"/>
                            </Border>
                            
                            <!-- Camera Badge Button -->
                            <Button Text="📷"
                                    FontSize="10"
                                    BackgroundColor="#2563EB"
                                    TextColor="White"
                                    CornerRadius="14"
                                    WidthRequest="28"
                                    HeightRequest="28"
                                    Padding="0"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    Clicked="OnEditProfileClicked"/>
                        </Grid>

                        <!-- Student Name & Status -->
                        <VerticalStackLayout Spacing="4" HorizontalOptions="Center">
                            <Label Text="Romeo Tolentino"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"
                                   HorizontalTextAlignment="Center"/>
                                   
                            <Border BackgroundColor="#E3FCEF"
                                    StrokeShape="RoundRectangle 16"
                                    StrokeThickness="0"
                                    Padding="8,2"
                                    HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="4">
                                    <Label Text="✓" TextColor="#00875A" FontAttributes="Bold" FontSize="11"/>
                                    <Label Text="Verified Student" TextColor="#00875A" FontAttributes="Bold" FontSize="11"/>
                                </HorizontalStackLayout>
                            </Border>
                            
                            <Label Text="2023-00123 • Information Technology (4th Yr)"
                                   FontSize="13"
                                   TextColor="#64748B"
                                   HorizontalTextAlignment="Center"/>
                        </VerticalStackLayout>

                        <!-- Edit Profile & Settings Button -->
                        <Button Text="⚙️ Edit Profile &amp; Settings"
                                BackgroundColor="Transparent"
                                TextColor="#2563EB"
                                BorderColor="#2563EB"
                                BorderWidth="1"
                                CornerRadius="20"
                                FontAttributes="Bold"
                                FontSize="13"
                                Padding="20,8"
                                Clicked="OnEditProfileClicked"/>

                        <!-- Stats Divider & Row -->
                        <BoxView HeightRequest="1" Color="#E2E8F0" Margin="0,8,0,0"/>

                        <Grid ColumnDefinitions="*, *" Padding="0,4,0,0">
                            <VerticalStackLayout Grid.Column="0" HorizontalOptions="Center">
                                <HorizontalStackLayout Spacing="4" HorizontalOptions="Center">
                                    <Label Text="4.9" FontAttributes="Bold" FontSize="16" TextColor="#0F172A"/>
                                    <Label Text="⭐" FontSize="14"/>
                                </HorizontalStackLayout>
                                <Label Text="Rating" FontSize="12" TextColor="#64748B" HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1" HorizontalOptions="Center">
                                <Label Text="18" FontAttributes="Bold" FontSize="16" TextColor="#0F172A" HorizontalOptions="Center"/>
                                <Label Text="Deals Done" FontSize="12" TextColor="#64748B" HorizontalOptions="Center"/>
                            </VerticalStackLayout>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- My Selling Items Section Card -->
                <Border BackgroundColor="White"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="1"
                        Stroke="#E2E8F0"
                        Padding="16">
                    <VerticalStackLayout Spacing="14">
                        
                        <HorizontalStackLayout Spacing="8">
                            <Label Text="🏪" FontSize="16"/>
                            <Label Text="My Selling Items &amp; Interested Buyers"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   TextColor="#0F172A"/>
                        </HorizontalStackLayout>

                        <!-- Seller Products List -->
                        <CollectionView x:Name="MyListingsCollectionView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border BackgroundColor="White"
                                            StrokeShape="RoundRectangle 16"
                                            StrokeThickness="1"
                                            Stroke="#E2E8F0"
                                            Padding="12"
                                            Margin="0,0,0,12">
                                        <VerticalStackLayout Spacing="8">
                                            <!-- Image -->
                                            <Image Source="{Binding ImageUrl}"
                                                   HeightRequest="150"
                                                   Aspect="AspectFill"/>
                                                   
                                            <Grid ColumnDefinitions="*, Auto">
                                                <Label Grid.Column="0" Text="{Binding PriceFormatted}" FontAttributes="Bold" FontSize="18" TextColor="#5F27CD"/>
                                                <Border Grid.Column="1" BackgroundColor="#FEF3C7" StrokeShape="RoundRectangle 12" Padding="8,4">
                                                    <Label Text="₱1.00 Fee Paid" TextColor="#D97706" FontAttributes="Bold" FontSize="11"/>
                                                </Border>
                                            </Grid>

                                            <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="14" TextColor="#0F172A"/>

                                            <Grid ColumnDefinitions="*, Auto" Padding="0,4">
                                                <HorizontalStackLayout Spacing="4">
                                                    <Label Text="{Binding SellerName}" FontAttributes="Bold" FontSize="12" TextColor="#334155"/>
                                                    <Border BackgroundColor="#E3FCEF" Padding="4,1">
                                                        <Label Text="✓ Verified" TextColor="#00875A" FontSize="10" FontAttributes="Bold"/>
                                                    </Border>
                                                </HorizontalStackLayout>
                                                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                                    <Label Text="📍" FontSize="12"/>
                                                    <Label Text="{Binding MeetupLocation}" FontSize="12" TextColor="#64748B"/>
                                                </HorizontalStackLayout>
                                            </Grid>

                                            <!-- Red Delete Post Button -->
                                            <Button Text="🗑️ Delete Post"
                                                    BackgroundColor="Transparent"
                                                    TextColor="#EF4444"
                                                    BorderColor="#EF4444"
                                                    BorderWidth="1"
                                                    CornerRadius="20"
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    Padding="12,6"
                                                    Clicked="OnDeletePostClicked"/>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                    </VerticalStackLayout>
                </Border>

                <!-- Log Out Account Button -->
                <Button Text="↳ Log Out Account"
                        BackgroundColor="Transparent"
                        TextColor="#EF4444"
                        BorderColor="#EF4444"
                        BorderWidth="1"
                        CornerRadius="20"
                        FontAttributes="Bold"
                        FontSize="14"
                        Padding="16,10"
                        Clicked="OnLogoutClicked"/>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>

</ContentPage>
